<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default: only HTTPS traffic is allowed, which is what your
         production backend should use. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow plain HTTP only for local development against
         10.0.2.2 (Android emulator's alias for your host machine)
         and localhost, so you can test against a backend running on
         your own computer without HTTPS. Remove this block once you
         only ever hit your real HTTPS backend. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
